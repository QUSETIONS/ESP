# OTA 地址（--ota-url 参数可覆盖）
DEFAULT_OTA_URL=https://ota.zectrix.com/xiaozhi/ota/

# 预设WiFi（编译时注入，避免每次刷机重新配网）
DEFAULT_WIFI_SSID=
DEFAULT_WIFI_PASSWORD=

# 后台云端推送（不要提交真实密钥）
ZECTRIX_API_BASE=https://cloud.zectrix.com/open/v1
ZECTRIX_API_KEY=
# 可选：由 systemd/Docker secret 挂载的一行密钥文件；环境变量 key 优先
ZECTRIX_API_KEY_FILE=

# 后台真实 ASR 网关（浏览器不接触厂商凭据）
MEETING_ASR_ENDPOINT=
MEETING_ASR_TOKEN=
